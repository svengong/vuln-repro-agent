#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
vulnrepro —— 统一入口

设计目标：让"启动 dashboard"和"跑完一条链"都变成一条命令，
而不是靠模型每次自由发挥。

子命令
------
  dashboard        启动 dashboard（默认行为）
  preflight        环境检测
  case validate    校验案例文件
  case scaffold    生成案例骨架
  case merge       校验后合并进 dashboard
  doctor           preflight + 案例校验 + dashboard 健康检查（一键体检）
  status           看 dashboard / 靶场 / 案例的当前状态

约定
----
* 没有子命令时默认 `dashboard`（"用户说启动 dashboard" → 直接可用）
* dashboard 已在运行则复用，不重复起进程
* 退出码：0 成功，1 失败，2 部分可用（WARN）
"""
from __future__ import annotations

import argparse
import json
import os
import signal
import socket
import subprocess
import sys
import time
from pathlib import Path

REPO = Path(__file__).resolve().parent.parent
DASH = REPO / "dashboard"
BIN = REPO / "bin"
PY = sys.executable or "python3"

DEFAULT_HOST = "127.0.0.1"
DEFAULT_PORT = 3010
PIDFILE = Path(os.environ.get("XDG_RUNTIME_DIR", "/tmp")) / "vuln-repro-dashboard.pid"


# ---------------------------------------------------------------------------
# 小工具
# ---------------------------------------------------------------------------

def port_open(host: str, port: int, timeout: float = 0.5) -> bool:
    try:
        with socket.create_connection((host, port), timeout=timeout):
            return True
    except OSError:
        return False


def http_ok(url: str, timeout: float = 2.0) -> bool:
    try:
        import urllib.request
        with urllib.request.urlopen(url, timeout=timeout) as r:
            return 200 <= r.status < 300
    except Exception:
        return False


def read_pid() -> int | None:
    try:
        return int(PIDFILE.read_text().strip())
    except Exception:
        return None


def pid_alive(pid: int) -> bool:
    try:
        os.kill(pid, 0)
        return True
    except OSError:
        return False


def find_dashboard_by_port(port: int) -> bool:
    """端口被占且 /healthz 正常，说明已经有一个 dashboard 在跑。"""
    return port_open(DEFAULT_HOST, port) and http_ok(f"http://{DEFAULT_HOST}:{port}/healthz")


def banner(msg: str) -> None:
    print(f"\n=== {msg} ===")


# ---------------------------------------------------------------------------
# dashboard
# ---------------------------------------------------------------------------

def cmd_dashboard(args) -> int:
    host, port = args.host, args.port

    if find_dashboard_by_port(port):
        pid = read_pid()
        print(f"✅ dashboard 已在运行: http://{host}:{port}"
              + (f" (pid {pid})" if pid else ""))
        return 0

    if port_open(host, port):
        print(f"❌ 端口 {port} 已被其它进程占用，且不是本 dashboard。", file=sys.stderr)
        print("   换端口: vulnrepro dashboard --port 3011", file=sys.stderr)
        return 1

    if not (DASH / "server.mjs").is_file():
        print(f"❌ 找不到 {DASH / 'server.mjs'}", file=sys.stderr)
        return 1

    node = "node"
    try:
        subprocess.run([node, "--version"], capture_output=True, check=True)
    except Exception:
        print("❌ 未找到 node，无法启动 dashboard", file=sys.stderr)
        return 1

    log = Path(args.log) if args.log else Path("/tmp/vuln-repro-dashboard.log")
    log.parent.mkdir(parents=True, exist_ok=True)

    env = dict(os.environ, PORT=str(port), HOST=host)
    with open(log, "ab") as fh:
        proc = subprocess.Popen(
            [node, "server.mjs"],
            cwd=str(DASH),
            stdout=fh, stderr=fh, stdin=subprocess.DEVNULL,
            env=env, start_new_session=True,
        )

    # 等它真的能响应，而不是"进程起来了"就算成功。
    deadline = time.time() + (args.timeout or 20)
    while time.time() < deadline:
        if http_ok(f"http://{host}:{port}/healthz"):
            PIDFILE.write_text(str(proc.pid))
            print(f"✅ dashboard 已启动: http://{host}:{port}  (pid {proc.pid})")
            print(f"   日志: {log}")
            if args.foreground:
                print("   （前台模式：Ctrl-C 结束）")
                try:
                    proc.wait()
                except KeyboardInterrupt:
                    proc.send_signal(signal.SIGTERM)
            return 0
        if proc.poll() is not None:
            print(f"❌ dashboard 进程已退出，见日志: {log}", file=sys.stderr)
            try:
                print(log.read_text()[-1500:], file=sys.stderr)
            except Exception:
                pass
            return 1
        time.sleep(0.3)

    print(f"⚠️  进程已起但 {args.timeout}s 内未响应，见日志: {log}", file=sys.stderr)
    return 2


def cmd_stop(_args) -> int:
    pid = read_pid()
    if not pid or not pid_alive(pid):
        print("➖ 没有本工具启动的 dashboard 在运行")
        PIDFILE.unlink(missing_ok=True)
        return 0
    os.kill(pid, signal.SIGTERM)
    for _ in range(30):
        if not pid_alive(pid):
            break
        time.sleep(0.2)
    PIDFILE.unlink(missing_ok=True)
    print(f"✅ 已停止 dashboard (pid {pid})")
    return 0


# ---------------------------------------------------------------------------
# preflight / case / doctor / status
# ---------------------------------------------------------------------------

def run_script(path: Path, argv: list[str]) -> int:
    return subprocess.call([PY, str(path)] + argv)


def cmd_preflight(args) -> int:
    argv = ["--format", args.format]
    if args.ports:
        argv += ["--ports"] + [str(p) for p in args.ports]
    if args.container:
        argv += ["--container", args.container]
    if args.products:
        argv += ["--products", str(args.products)]
    if args.control:
        argv.append("--control")
    if args.limits:
        argv.append("--limits")
    if args.dashboard_done:
        argv.append("--dashboard")
    if args.strict:
        argv.append("--strict")
    return run_script(BIN / "preflight.py", argv)


def cmd_case(args) -> int:
    argv = [args.case_cmd]
    if args.case_cmd == "validate":
        argv += args.paths or []
    elif args.case_cmd == "merge":
        argv += [args.file]
    return run_script(BIN / "casefile.py", argv)


def cmd_doctor(args) -> int:
    banner("1/3 环境检测")
    rc1 = cmd_preflight(argparse.Namespace(
        format="text", ports=args.ports, container=args.container,
        products=0, control=False, limits=False, dashboard_done=False, strict=False))

    banner("2/3 案例文件校验")
    rc2 = run_script(BIN / "casefile.py", ["validate", str(DASH / "data" / "cases")])

    banner("3/3 dashboard 健康")
    alive = find_dashboard_by_port(args.port)
    if alive:
        print(f"✅ http://{DEFAULT_HOST}:{args.port} 正常")
        rc3 = 0
    else:
        print("➖ dashboard 未运行（vulnrepro dashboard 可启动）")
        rc3 = 0

    banner("汇总")
    worst = max(rc for rc in (rc1, rc2, rc3) if rc is not None)
    print(f"环境={rc1} 案例={rc2} dashboard={rc3}")
    if worst == 0:
        print("✅ 一切就绪")
    elif worst == 2:
        print("⚠️  可用，但有 WARN 项需写进结论")
    else:
        print("❌ 有阻塞问题，见上")
    return worst


def cmd_status(args) -> int:
    print("vuln-repro 状态")
    print(f"  仓库: {REPO}")
    print(f"  dashboard: {'运行中' if find_dashboard_by_port(args.port) else '未运行'}"
          f"  http://{DEFAULT_HOST}:{args.port}")

    cases = sorted((DASH / "data" / "cases").glob("*.json"))
    print(f"  案例: {len(cases)} 个")
    for f in cases:
        try:
            d = json.loads(f.read_text(encoding="utf-8"))
            print(f"    - {d.get('id', f.stem)}: {d.get('title', '')}")
        except Exception as e:
            print(f"    - {f.name}: 解析失败 ({e})")

    try:
        out = subprocess.run(["docker", "ps", "--format", "{{.Names}}"],
                             capture_output=True, text=True, timeout=10).stdout
        names = [n for n in out.split() if n]
        print(f"  容器: {len(names)} 个运行中")
        pref = {}
        for n in names:
            p = n.split("-")[0]
            pref[p] = pref.get(p, 0) + 1
        if pref:
            print("    " + ", ".join(f"{k}×{v}" for k, v in sorted(pref.items())))
    except Exception:
        print("  容器: 无法查询（docker 不可用）")
    return 0


# ---------------------------------------------------------------------------
# main
# ---------------------------------------------------------------------------

def main() -> int:
    ap = argparse.ArgumentParser(
        prog="vulnrepro",
        description="vuln-repro agent 统一入口（无子命令即启动 dashboard）")
    ap.add_argument("--version", action="version", version="vuln-repro 1.0.0")

    common = argparse.ArgumentParser(add_help=False)
    common.add_argument("--port", type=int, default=DEFAULT_PORT)

    sub = ap.add_subparsers(dest="cmd")

    d = sub.add_parser("dashboard", parents=[common], help="启动 dashboard（默认）")
    d.add_argument("--host", default=DEFAULT_HOST)
    d.add_argument("--log", default=None)
    d.add_argument("--timeout", type=int, default=20)
    d.add_argument("--foreground", action="store_true")
    d.set_defaults(func=cmd_dashboard)

    s = sub.add_parser("stop", help="停止 dashboard")
    s.set_defaults(func=cmd_stop)

    p = sub.add_parser("preflight", help="环境检测")
    p.add_argument("--format", choices=["text", "json"], default="text")
    p.add_argument("--ports", type=int, nargs="*", default=[])
    p.add_argument("--container", default=None)
    p.add_argument("--products", type=int, default=0)
    p.add_argument("--control", action="store_true")
    p.add_argument("--limits", action="store_true")
    p.add_argument("--dashboard-done", dest="dashboard_done", action="store_true")
    p.add_argument("--strict", action="store_true")
    p.set_defaults(func=cmd_preflight)

    c = sub.add_parser("case", help="案例文件工具")
    c.add_argument("case_cmd", choices=["validate", "scaffold", "merge"])
    c.add_argument("paths", nargs="*", default=[])
    c.add_argument("--file", default=None)
    c.set_defaults(func=cmd_case)

    doc = sub.add_parser("doctor", parents=[common], help="一键体检")
    doc.add_argument("--ports", type=int, nargs="*", default=[])
    doc.add_argument("--container", default=None)
    doc.set_defaults(func=cmd_doctor)

    st = sub.add_parser("status", parents=[common], help="当前状态")
    st.set_defaults(func=cmd_status)

    args = ap.parse_args()
    if not getattr(args, "cmd", None):
        # 无子命令 → 默认启动 dashboard（"启动 dashboard" 一句话即可）
        args = argparse.Namespace(cmd="dashboard", func=cmd_dashboard,
                                  host=DEFAULT_HOST, port=DEFAULT_PORT,
                                  log=None, timeout=20, foreground=False)
    return args.func(args)


if __name__ == "__main__":
    sys.exit(main())
